# Cloudinary — read on the server only, never sent to the browser.
# Required: all three. The verification metadata fields listed in
# docs/VERIFICATION_MODEL.md must also exist in the account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public base URL of this deployment. It decides where the QR code and the
# verification links point, so it must be the address a third party can open.
NEXT_PUBLIC_APP_URL=http://localhost:3000
